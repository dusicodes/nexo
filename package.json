{
  "name": "nexo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate --silent && pglite-server --db=.data/nexo --port=54329 --max-connections=10 --include-database-url --run \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tauri": "tauri",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev:sql": "tsx src/db/dev-sql.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.84",
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.12.4",
    "ai": "^7.0.170",
    "better-auth": "^1.7.21",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
