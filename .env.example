# nexo environment template. Copy to .env.local, fill in, never commit real values.
# .env.local is gitignored; this file is the documented source of truth.

# --- Auth (Better Auth) ----------------------------------------------------
# Required. Generate with: npx @better-auth/cli secret  (or openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public base URL of the app. Defaults to the incoming request origin.
# Set explicitly in production, e.g. https://nexo.example.com
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Leave both empty to run without Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Drizzle) ----------------------------------------------------
# Leave empty to use local PGlite (the default local-first development path).
# Set to a postgres:// or postgresql:// URL to use a Postgres server instead.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexo
DATABASE_URL=
# Directory for the local PGlite database. Default: .data/nexo (gitignored).
# LOCAL_DB_PATH=.data/nexo
# Use DATABASE_URL=memory for a throwaway in-memory database.
# DATABASE_URL=memory

# --- AI (Vercel AI SDK + DeepSeek) ------------------------------------------
# DeepSeek API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Model id used by the assistant seam. Default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
